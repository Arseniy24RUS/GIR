{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GIIP official national-statistics numeric sources",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "user_agent": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["source_id", "statistical_office", "iso3", "official_host", "url", "format", "fields"],
        "properties": {
          "source_id": {"type": "string", "minLength": 3},
          "statistical_office": {"type": "string", "minLength": 3},
          "iso3": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "official_host": {"type": "string", "minLength": 4},
          "url": {"type": "string", "pattern": "^https://"},
          "method": {"enum": ["GET", "POST"]},
          "format": {"enum": ["json", "csv"]},
          "records_path": {"type": ["string", "null"]},
          "params": {"type": "object"},
          "headers": {"type": "object"},
          "request_json": {},
          "encoding": {"type": "string"},
          "delimiter": {"type": "string", "maxLength": 1},
          "decimal": {"enum": [".", ","]},
          "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 600},
          "max_records": {"type": "integer", "minimum": 1},
          "polite_delay_seconds": {"type": "number", "minimum": 0},
          "fixed": {"type": "object"},
          "fields": {
            "type": "object",
            "required": ["metric_code", "year", "value", "unit", "metric_name_ru", "metric_name_en"]
          },
          "include_in_htei": {"type": "boolean"},
          "htei_component_code": {
            "enum": ["HT_EMPLOYMENT_SHARE", "HIGH_TECH_OCCUPATIONS", "RND_PERSONNEL", "STEM_PIPELINE", "TECH_OUTPUTS", "CORPORATE_STRATEGY_AND_DEMAND"]
          },
          "source_priority": {"type": "integer", "minimum": 1, "maximum": 99},
          "license_or_terms": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
