{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CountryProfile",
  "type": "object",
  "required": ["iso3", "year", "indices", "diagnostics"],
  "properties": {
    "iso3": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "year": {"type": "integer", "minimum": 1990},
    "indices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index_id", "score", "rank", "provenance"],
        "properties": {
          "index_id": {"type": "string"},
          "score": {"type": ["number", "null"]},
          "rank": {"type": ["integer", "null"]},
          "provenance": {"type": "object"}
        }
      }
    },
    "diagnostics": {"type": "array"}
  }
}
